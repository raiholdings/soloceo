# ==============================================================
# SoloCEO — Biến môi trường chuẩn (CLAUDE.md Phần 11)
# Copy thành .env ở gốc repo (dev) hoặc điền vào Coolify (prod).
# ==============================================================

# ---------- Core ----------
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soloceo
REDIS_URL=redis://localhost:6379
# AES-256-GCM key cho bảng secrets (32 bytes hex) — KHÔNG log, không commit
MASTER_KEY=
PUBLIC_APP_DOMAIN=app.soloceo.vn

# ---------- API ----------
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Supabase (self-host) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secret verify JWT GoTrue
JWT_SUPABASE_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Coolify ----------
COOLIFY_BASE_URL=https://coolify.soloceo.internal
COOLIFY_API_TOKEN=

# ---------- LLM Gateway ----------
LITELLM_BASE_URL=https://llm.soloceo.vn
LITELLM_MASTER_KEY=
LITELLM_DB_URL=
ANTHROPIC_API_KEY=

# ---------- Observability ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://trace.soloceo.vn

# ---------- Payments ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---------- Email ----------
RESEND_API_KEY=

# ---------- SoloCEO Community (WoWonder OAuth — nhà cung cấp danh tính) ----------
WOWONDER_BASE_URL=https://my.soloceo.vn
WOWONDER_APP_ID=
WOWONDER_APP_SECRET=
WOWONDER_SERVER_KEY=
FRONTEND_AFTER_LOGIN_URL=https://soloceo.vn/dang-nhap

# BytePlus ModelArk (DeepSeek V4 — model mặc định, region Singapore)
BYTEPLUS_ARK_API_KEY=

# Nhân Hòa (đại lý tên miền — module domains)
NHANHOA_AUTH_ID=
NHANHOA_AUTH_USER=
NHANHOA_AUTH_PWD=
DOMAIN_MARKUP_PCT=20
# NHANHOA_FAKE=1  # giả lập khi chưa có credentials

# OIDC provider (bọc WoWonder cho DeerFlow SSO)
OIDC_PRIVATE_KEY=
OIDC_ISSUER=https://api.soloceo.vn/v1/oidc
OIDC_CLIENT_ID=deerflow
OIDC_CLIENT_SECRET=
