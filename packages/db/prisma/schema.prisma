// SoloCEO — schema gốc theo CLAUDE.md Phần 4.
// Mọi bảng nghiệp vụ scope theo orgId (RLS bật trên Supabase — SQL trong packages/db/rls/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1 Solo CEO = 1 Org (multi-tenancy gốc)
model Org {
  id            String         @id @default(uuid())
  name          String
  ownerUserId   String // Supabase auth.users.id
  plan          Plan           @default(STARTER)
  status        OrgStatus      @default(ACTIVE)
  createdAt     DateTime       @default(now())
  ventures      Venture[]
  subscriptions Subscription[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  aiUsages      AiUsage[]
  offers        Offer[]
}

// Doanh nghiệp một người — đơn vị giá trị lõi
model Venture {
  id              String        @id @default(uuid())
  orgId           String
  name            String
  slug            String        @unique // → {slug}.app.soloceo.vn
  industry        String? // real_estate|fnb|education|services|other
  description     String?
  logoUrl         String?
  status          VentureStatus @default(DRAFT)
  revenueVerified Boolean       @default(false)
  createdAt       DateTime      @default(now())
  org             Org           @relation(fields: [orgId], references: [id])
  installs        AppInstall[]
  transactions    Transaction[]
  listing         Listing?
  aiUsages        AiUsage[]

  @@index([orgId])
}

// App Store — giải pháp mã nguồn mở đóng gói sẵn
model CatalogApp {
  id              String       @id @default(uuid())
  key             String       @unique // "dify","activepieces","site-nextjs","crm-twenty",...
  name            String
  category        String // ai|automation|web|crm|commerce
  composeTemplate String // đường dẫn infra/coolify/templates/{key}.yml
  defaultEnv      Json
  planMin         Plan         @default(STARTER)
  active          Boolean      @default(true)
  installs        AppInstall[]
}

// 1 app đã cài cho 1 venture
model AppInstall {
  id           String        @id @default(uuid())
  ventureId    String
  catalogAppId String
  coolifyAppId String? // id resource bên Coolify
  url          String? // https://{slug}-{app}.app.soloceo.vn
  status       InstallStatus @default(QUEUED)
  envOverrides Json?
  createdAt    DateTime      @default(now())
  venture      Venture       @relation(fields: [ventureId], references: [id])
  catalogApp   CatalogApp    @relation(fields: [catalogAppId], references: [id])

  @@index([ventureId])
}

// Gói cước nền tảng
model Subscription {
  id               String   @id @default(uuid())
  orgId            String
  plan             Plan
  provider         String // stripe|payos
  providerRef      String // subscription id / order code
  status           String // active|past_due|canceled
  currentPeriodEnd DateTime
  org              Org      @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// SỔ CÁI DOANH THU — trái tim của Sàn M&A
model Transaction {
  id          String      @id @default(uuid())
  ventureId   String
  direction   TxDirection // IN|OUT|PLATFORM_FEE
  grossAmount Decimal     @db.Decimal(18, 2)
  currency    String      @default("VND")
  provider    String // stripe|payos|manual
  providerRef String      @unique // idempotency key
  customerRef String?
  occurredAt  DateTime
  verified    Boolean     @default(true) // true nếu từ webhook cổng thanh toán
  meta        Json?
  venture     Venture     @relation(fields: [ventureId], references: [id])

  @@index([ventureId, occurredAt])
}

// Niêm yết M&A
model Listing {
  id           String        @id @default(uuid())
  ventureId    String        @unique
  askPrice     Decimal       @db.Decimal(18, 2)
  currency     String        @default("VND")
  ttmRevenue   Decimal?      @db.Decimal(18, 2) // doanh thu 12 tháng — tính từ Transaction
  ttmProfitEst Decimal?      @db.Decimal(18, 2)
  summary      String
  status       ListingStatus @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now())
  venture      Venture       @relation(fields: [ventureId], references: [id])
  offers       Offer[]
}

model Offer {
  id         String    @id @default(uuid())
  listingId  String
  buyerOrgId String
  amount     Decimal   @db.Decimal(18, 2)
  message    String?
  status     String    @default("open") // open|accepted|rejected|withdrawn
  createdAt  DateTime  @default(now())
  listing    Listing   @relation(fields: [listingId], references: [id])
  buyerOrg   Org       @relation(fields: [buyerOrgId], references: [id])
  dealRoom   DealRoom?

  @@index([listingId])
}

// NDA click-wrap: buyer phải chấp nhận trước khi xem số chi tiết (Phần 6.5)
model NdaAcceptance {
  id         String   @id @default(uuid())
  listingId  String
  orgId      String
  acceptedAt DateTime @default(now())

  @@unique([listingId, orgId])
}

// Deal-room mở khi offer được chấp nhận: thread + checklist chuyển giao,
// escrow THỦ CÔNG bởi admin (ADR-003) — mỗi bước cần admin phê duyệt.
model DealRoom {
  id        String        @id @default(uuid())
  listingId String
  offerId   String        @unique
  status    String        @default("open") // open|transferred|closed
  checklist Json // [{key, label, done, doneAt}]
  createdAt DateTime      @default(now())
  offer     Offer         @relation(fields: [offerId], references: [id])
  messages  DealMessage[]
}

model DealMessage {
  id         String   @id @default(uuid())
  dealRoomId String
  orgId      String
  content    String
  createdAt  DateTime @default(now())
  dealRoom   DealRoom @relation(fields: [dealRoomId], references: [id])

  @@index([dealRoomId])
}

// Audit log hành động quản trị (Giai đoạn 7 — tạo sớm để admin dùng ngay)
model AdminAction {
  id        String   @id @default(uuid())
  adminUser String
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

// Feed cộng đồng MVP
model Post {
  id        String    @id @default(uuid())
  orgId     String
  ventureId String?
  content   String
  mediaUrls Json?
  createdAt DateTime  @default(now())
  org       Org       @relation(fields: [orgId], references: [id])
  comments  Comment[]
  likes     Like[]

  @@index([orgId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  orgId     String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  org       Org      @relation(fields: [orgId], references: [id])

  @@index([postId])
}

model Like {
  id     String @id @default(uuid())
  postId String
  orgId  String
  post   Post   @relation(fields: [postId], references: [id])
  org    Org    @relation(fields: [orgId], references: [id])

  @@unique([postId, orgId])
}

// Vault đơn giản (CLAUDE.md Phần 7): giá trị mã hóa AES-256-GCM bằng
// MASTER_KEY (env api-core). KHÔNG bao giờ log giá trị giải mã.
model Secret {
  id        String   @id @default(uuid())
  orgId     String
  key       String // vd: "litellm_virtual_key", "app:dify:secret_key"
  valueEnc  String // base64(iv || ciphertext || authTag)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, key])
}

// Đồng bộ từ LiteLLM/Langfuse mỗi giờ
model AiUsage {
  id           String   @id @default(uuid())
  orgId        String
  ventureId    String?
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @db.Decimal(12, 6)
  day          DateTime @db.Date
  org          Org      @relation(fields: [orgId], references: [id])
  venture      Venture? @relation(fields: [ventureId], references: [id])

  @@index([orgId, day])
}

enum Plan {
  STARTER
  GROWTH
  SCALE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CHURNED
}

enum VentureStatus {
  DRAFT
  PROVISIONING
  LIVE
  PAUSED
  LISTED
  SOLD
}

enum InstallStatus {
  QUEUED
  DEPLOYING
  RUNNING
  FAILED
  REMOVED
  ARCHIVED // v2 cleanup (R0 §C9): bản cài cụm v1 (claw3d/openclaw) đã lưu trữ, KHÔNG xoá cứng
}

enum TxDirection {
  IN
  OUT
  PLATFORM_FEE
}

enum ListingStatus {
  PENDING_REVIEW
  LIVE
  IN_ESCROW
  SOLD
  WITHDRAWN
}

// Đơn mua tên miền qua đại lý Nhân Hòa (CEO mua ngay trên OS)
model DomainOrder {
  id          String            @id @default(uuid())
  orgId       String
  ventureId   String?
  domain      String // "cuahangcuatoi"
  ext         String // ".com" | ".vn" | ...
  years       Int               @default(1)
  priceVnd    Decimal           @db.Decimal(18, 2)
  status      DomainOrderStatus @default(PENDING_APPROVAL)
  contact     Json // {realname, phone, email, address?, company?, city, country}
  providerMsg String? // msg trả về từ Nhân Hòa
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([orgId, createdAt])
}

enum DomainOrderStatus {
  PENDING_PAYMENT // chờ CEO thanh toán
  PENDING_APPROVAL // chờ admin duyệt (human-in-the-loop — chi tiền số dư đại lý)
  REGISTERING // đã gửi Nhân Hòa
  ACTIVE // đăng ký thành công
  FAILED
  CANCELED
}

// ============================================================================
// SoloCEO OS v2 (PHA 3) — HITL 2 tầng (arishem gate + interrupt), DLP, egress,
// channel. Tham chiếu: research/R6-report.md (arishem/godlp/g3), R7 (Zalo),
// R1/R3 (interrupt-resume ↔ ApprovalRequest). Nghị định 13/2023 (audit + mask).
// ============================================================================

/// Luật gác cổng HITL (arishem) — rule là DỮ LIỆU, sửa không deploy lại code.
model Rule {
  id            String       @id @default(uuid())
  orgId         String? // null = rule toàn nền tảng (áp mọi org)
  name          String
  description   String?
  actionType    String // khớp SENSITIVE_ACTIONS (packages/shared)
  priority      Int          @default(100) // nhỏ = ưu tiên đánh giá trước
  conditionJson Json // cây điều kiện arishem (JSON)
  decision      RuleDecision
  approvalTier  Int? // 1|2 (chỉ khi decision=REQUIRE_APPROVAL)
  enabled       Boolean      @default(true)
  version       Int          @default(1)
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId, actionType, enabled])
}

/// Audit mọi phán quyết của rules-engine (context ĐÃ mask PII trước khi lưu).
model RuleDecisionLog {
  id            String       @id @default(uuid())
  orgId         String
  ventureId     String?
  actionType    String
  contextJson   Json
  decision      RuleDecision
  matchedRuleId String?
  actorUserId   String?
  createdAt     DateTime     @default(now())

  @@index([orgId, createdAt])
}

/// Hàng đợi HITL khi decision=REQUIRE_APPROVAL (dùng chung cho FlowGram human_approval).
model ApprovalRequest {
  id            String         @id @default(uuid())
  orgId         String
  ventureId     String?
  actionType    String
  payloadJson   Json // payload tool-call bị giữ (PII đã mask)
  matchedRuleId String?
  tier          Int // 1=auto-policy, 2=người duyệt
  // Nối interrupt-resume DeerFlow (R1): thread/run để resume sau khi duyệt.
  threadId      String?
  runId         String?
  status        ApprovalStatus @default(PENDING)
  decidedBy     String?
  decidedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([orgId, status])
}

/// Allowlist domain egress per-org (g3proxy) — sinh config g3 từ đây.
model EgressAllowlist {
  id        String   @id @default(uuid())
  orgId     String
  domain    String // vd "api.stripe.com", "*.payos.vn"
  enabled   Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@unique([orgId, domain])
  @@index([orgId, enabled])
}

/// Liên kết kênh nhắn tin (Zalo OA/Telegram) → org/venture (R7). Token OA lưu ở Secret.
model ChannelBinding {
  id         String   @id @default(uuid())
  orgId      String
  ventureId  String?
  channel    String // "zalo" | "telegram"
  externalId String // Zalo oa_id / telegram bot id
  secretRef  String // key trong bảng Secret chứa token (mã hóa AES-256-GCM)
  status     String   @default("active")
  createdAt  DateTime @default(now())

  @@unique([channel, externalId]) // khóa route webhook
  @@index([orgId, ventureId])
}

enum RuleDecision {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// N2 FlowGram — quy trình tái dùng của CEO (persist theo org_id).
/// graphJson = { nodes: [{id,type,title,config}], edges: [{from,to,branch?}] }.
model Flow {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  graphJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, updatedAt])
}
